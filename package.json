{
  "name": "gimme-idea",
  "version": "2.0.0-foundation",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": ">=10.18.3 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:program": "anchor test --skip-build",
    "program:build": "cargo build-sbf && anchor idl build --skip-lint -o target/idl/bounty_escrow.json -t target/types/bounty_escrow.ts",
    "program:deploy:devnet": "anchor deploy --provider.cluster devnet --provider.wallet \"${SOLANA_UPGRADE_AUTHORITY_KEYPAIR:?Set SOLANA_UPGRADE_AUTHORITY_KEYPAIR to the Fzcna...KLJm keypair path}\" --program-name bounty_escrow",
    "program:smoke:devnet": "ANCHOR_PROVIDER_URL=https://api.devnet.solana.com ANCHOR_WALLET=~/.config/solana/id.json tsx scripts/devnet-bounty-smoke.ts",
    "program:authority:devnet": "solana program show BB2bMK8gwrDk3YG3GFECqnwnFigDoxvKDwJZiTXtzCK6 --url devnet",
    "test:e2e": "playwright test",
    "load:v1": "node scripts/load-v1.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:generate": "pnpm --filter @gimme-idea/db db:generate",
    "db:seed:verify": "pnpm --filter @gimme-idea/db seed:verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@coral-xyz/anchor": "0.31.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/bn.js": "5.2.0",
    "@types/node": "22.18.7",
    "bn.js": "5.2.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tsx": "4.20.5",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.18.0": "1.18.0",
      "bn.js@>=5.0.0 <5.2.3": "5.2.3",
      "decode-uri-component@<=0.4.2": "0.5.0",
      "stream-json@<=3.4.0": "3.5.0",
      "uuid@<11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
