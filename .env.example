# Copy to backend/.env and frontend/.env.local as needed.
# Never commit real secrets.

# --- Backend (NestJS) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=change-me-long-random
OPENAI_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PORT=3001

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Realtime egress: keep false unless product explicitly needs live channels
NEXT_PUBLIC_ENABLE_REALTIME=false
NEXT_PUBLIC_DISABLE_REALTIME=true
# Per-channel (only evaluated when global realtime is true)
NEXT_PUBLIC_ENABLE_REALTIME_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_REALTIME_TEAM_INVITES=false
NEXT_PUBLIC_ENABLE_REALTIME_ANNOUNCEMENTS=false
NEXT_PUBLIC_ENABLE_REALTIME_COMMENTS=false
NEXT_PUBLIC_ENABLE_REALTIME_PROJECTS=false

NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
