{
  "name": "@gimme-idea/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:colosseum": "tsx src/backfill.ts"
  },
  "dependencies": {
    "@gimme-idea/config": "workspace:*",
    "@gimme-idea/db": "workspace:*",
    "@gimme-idea/solana": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "bullmq": "5.58.9",
    "fastify": "5.12.1",
    "ioredis": "5.7.0"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
