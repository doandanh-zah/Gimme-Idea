{
  "name": "gimme-idea-backend",
  "version": "1.0.0",
  "description": "Gimme Idea Backend - Solana Feedback Platform API",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); try { fs.rmSync('dist',{recursive:true,force:true}); } catch (_) {}\"",
    "build": "node -e \"const fs=require('fs');const p='node_modules/rpc-websockets/node_modules/uuid/package.json';const u=fs.existsSync(p)?JSON.parse(fs.readFileSync(p,'utf8')):JSON.parse(fs.readFileSync('node_modules/uuid/package.json','utf8'));if(u.type==='module'||Number(u.version.split('.')[0])>=10){console.error('Bad uuid for CJS:',u.version,u.type);process.exit(1)}console.log('uuid ok',u.version);require('rpc-websockets');require('@solana/web3.js');\" && node ./node_modules/@nestjs/cli/bin/nest.js build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@solana/web3.js": "^1.87.6",
    "@supabase/supabase-js": "^2.39.0",
    "bs58": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.9.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "stripe": "^17.7.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.1.3",
    "uuid": "8.3.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "13.0.6",
    "lodash": "4.18.1",
    "minimatch": "10.2.5",
    "multer": "2.2.0",
    "picomatch": "4.0.5",
    "qs": "6.15.3",
    "tmp": "0.2.7",
    "webpack": "5.108.4",
    "rpc-websockets": {
      "uuid": "8.3.2"
    },
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0"
  }
}
