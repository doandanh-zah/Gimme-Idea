# Backend API URL
# Development: http://localhost:3001/api
# Production: https://gimme-idea.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Supabase Configuration (for direct client access if needed)
# IMPORTANT: ANON_KEY must be the FULL 3-part JWT from Supabase
# (Project Settings → API → anon public). It looks like:
#   eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6....sig
# A truncated 2-part value causes production Google login to fail with
# "Invalid API key" after OAuth redirect. Never strip the header segment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_PAYLOAD.YOUR_SIGNATURE

# Realtime is globally and per-channel opt-in. Keep safe/off by default.
# Product notifications (bell + API). Keep false to avoid noise/egress.
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false

# Realtime (Supabase WS) — keep fully off unless product opts in
NEXT_PUBLIC_ENABLE_REALTIME=false
NEXT_PUBLIC_DISABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_REALTIME_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_REALTIME_TEAM_INVITES=false
NEXT_PUBLIC_ENABLE_REALTIME_ANNOUNCEMENTS=false
NEXT_PUBLIC_ENABLE_REALTIME_COMMENTS=false
NEXT_PUBLIC_ENABLE_REALTIME_PROJECTS=false

# Solana Configuration
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# LazorKit Passkey Wallet Configuration
NEXT_PUBLIC_LAZORKIT_PAYMASTER_URL=https://kora.lazorkit.com/
